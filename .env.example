# ============================================================
# Налаштування системи реєстрації на заходи
# ============================================================
# Скопіюйте цей файл у .env і змініть значення під свою систему.

# --- Сервер ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=zmini-cei-sekret-na-svij

# --- База даних MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event_registration

# --- SMTP для email-підтверджень ---
# Якщо НЕ заповнено - листи будуть виводитись у консоль (dev-режим).
# Для Gmail потрібен App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@events.local
